{
  "expo": {
    "name": "feed-case",
    "slug": "feed-case",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inesryder.feed-case"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withPodsMinDeploymentTarget"
    ]
  }
}
